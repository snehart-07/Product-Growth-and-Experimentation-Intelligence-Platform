<?xml version='1.0'?>
<!-- GrowthLab palettes for Tableau Public.
     Copy to:  ~/Documents/My Tableau Public Repository/Preferences.tps  (merge if one exists), then restart Tableau. -->
<workbook>
  <preferences>
    <color-palette name="GrowthLab categorical" type="regular">
      <color>#5B4BEA</color> <!-- indigo: primary / treatment -->
      <color>#A3A9B8</color> <!-- grey: control / reference -->
      <color>#0F9F8F</color> <!-- teal: favourable -->
      <color>#E5534B</color> <!-- coral: adverse -->
      <color>#C7881B</color> <!-- amber: uncertain / warning -->
      <color>#8E83F3</color> <!-- indigo 2 -->
      <color>#CFCAFA</color> <!-- indigo 3 -->
      <color>#0E1631</color> <!-- ink -->
    </color-palette>
    <color-palette name="GrowthLab status" type="regular">
      <color>#0F9F8F</color> <!-- clearly better / pass -->
      <color>#E5534B</color> <!-- clearly worse / not pass -->
      <color>#A3A9B8</color> <!-- unclear -->
      <color>#C7881B</color> <!-- missing / warning -->
    </color-palette>
    <color-palette name="GrowthLab retention" type="ordered-sequential">
      <color>#F1EFFE</color>
      <color>#B3AAF7</color>
      <color>#5B4BEA</color>
      <color>#2D2496</color>
    </color-palette>
    <color-palette name="GrowthLab effect" type="ordered-diverging">
      <color>#E5534B</color>
      <color>#F7F6F2</color>
      <color>#0F9F8F</color>
    </color-palette>
  </preferences>
</workbook>
